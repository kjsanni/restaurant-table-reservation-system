{
  "info": {
    "_postman_id": "rtrs-starter-collection",
    "name": "RTRS API Starter",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Starter Postman collection for the Restaurant Table Reservation System (RTRS)."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "apiPath", "value": "/api/v1" },
    { "key": "csrfToken", "value": "YOUR_CSRF_TOKEN" },
    { "key": "reservationId", "value": "1" },
    { "key": "tableId", "value": "1" }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}{{apiPath}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get CSRF Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPath}}/csrf-token"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-xsrf-token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@rtrs.com\",\"password\":\"admin123\"}"
            },
            "url": "{{baseUrl}}{{apiPath}}/auth/login"
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-xsrf-token", "value": "{{csrfToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPath}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Create Reservation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-xsrf-token", "value": "{{csrfToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"customerName\":\"John Doe\",\"partySize\":4,\"resDate\":\"2026-07-29\",\"resTime\":\"19:00\",\"notes\":\"Window seat preferred\"}"
            },
            "url": "{{baseUrl}}{{apiPath}}/reservations"
          }
        },
        {
          "name": "Get Reservation",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-xsrf-token", "value": "{{csrfToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPath}}/reservations/{{reservationId}}"
          }
        },
        {
          "name": "Cancel Reservation",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "x-xsrf-token", "value": "{{csrfToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPath}}/reservations/{{reservationId}}"
          }
        }
      ]
    },
    {
      "name": "Tables",
      "item": [
        {
          "name": "List Tables",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-xsrf-token", "value": "{{csrfToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPath}}/tables"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Add Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-xsrf-token", "value": "{{csrfToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"amount\":150.0,\"method\":\"cash\",\"currency\":\"GHS\"}"
            },
            "url": "{{baseUrl}}{{apiPath}}/reservations/{{reservationId}}/payments"
          }
        }
      ]
    },
    {
      "name": "Super Admin Platform",
      "item": [
        {
          "name": "List Tenants",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-xsrf-token", "value": "{{csrfToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPath}}/admin/tenants"
          }
        },
        {
          "name": "Platform Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-xsrf-token", "value": "{{csrfToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPath}}/admin/audit-logs"
          }
        }
      ]
    }
  ]
}
