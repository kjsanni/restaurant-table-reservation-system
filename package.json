{
  "name": "restaurant-table-reservation-system",
  "version": "1.1.0",
  "description": "Restaurant Table Reservation System",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:front-end": "cd front-end && npm run dev",
    "start:back-end": "npm --prefix ./back-end start",
    "start:dev": "npm run --prefix ./back-end app:dev",
    "start:prod": "npm run --prefix ./back-end app:prod",
    "codacy:analyze": "npm --prefix ./back-end run codacy:analyze",
    "codacy:info": "npm --prefix ./back-end run codacy:info",
    "version:bump": "node -e \"const fs=require('fs');const v=process.argv[1];if(!v)throw new Error('Usage: npm run version:bump -- <new-version>');fs.writeFileSync('VERSION',v);fs.writeFileSync('package.json',JSON.stringify({...JSON.parse(fs.readFileSync('package.json','utf8')),version:v},null,2));\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/slavyanHristov/Restaurant-Table-Reservation-System.git"
  },
  "author": "Slavyan Hristov Hristov",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/slavyanHristov/Restaurant-Table-Reservation-System/issues"
  },
  "homepage": "https://github.com/slavyanHristov/Restaurant-Table-Reservation-System#readme",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/vue": "^0.5.0",
    "csurf": "^1.11.1",
    "express-rate-limit": "^8.5.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5"
  }
}