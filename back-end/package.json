{
  "name": "restaurant-table-reservation-system-back-end",
  "version": "1.1.0",
  "description": "Back-end of Restaurant Table Reservation System. Created with Node.JS",
  "repository": {
    "type": "git",
    "url": "https://github.com/slavyanHristov/restaurant-table-reservation-system",
    "directory": "/back-end"
  },
  "main": "app.js",
  "scripts": {
    "test": "jest",
    "start": "node ./src/app.js",
    "start:dev": "npm run migrate:up && nodemon -L ./src/app.js",
    "start:prod": "npm run migrate:up && node ./src/app.js",
    "restart:backend": "bash scripts/restart-backend.sh",
    "app:dev": "concurrently -n \"server,client\" -c \"bgYellow,bgGreen\" \"npm run start:dev\" \"npm run --prefix ../front-end dev\"",
    "app:prod": "concurrently -n \"server,client\" -c \"bgYellow,bgGreen\" \"npm run start:prod\" \"npm run --prefix ../front-end dev\"",
    "migrate:up": "npx sequelize db:migrate",
    "migrate:undo": "npx sequelize db:migrate:undo",
    "seed:all": "npx sequelize db:seed:all",
    "seed:e2e": "npx sequelize db:seed --seed 20260807000000-e2e-test-data.js",
    "seed:undo": "npx sequelize db:seed:undo:all",
    "loadtest:seed": "node load-tests/seed.js",
    "loadtest:seed:clean": "node load-tests/seed.js --clean",
    "loadtest:unseed": "node load-tests/unseed.js",
    "test:load": "node load-tests/run.js --scenario all",
    "loadtest:baseline": "node load-tests/run.js --scenario all --sessions 1 --tenantHeader false --label baseline",
    "loadtest:tenant": "node load-tests/run.js --scenario all --sessions 100 --label tenant",
    "loadtest:leak": "node load-tests/leak-check.js --sample 20 --rounds 3",
    "loadtest:queue": "node load-tests/queue-bench.js --jobs 500 --concurrency 5 --sendMs 50",
    "test:postman": "bash scripts/smoke-test.sh",
    "test:postman:prod": "BASE_URL=http://192.168.88.10 bash scripts/smoke-test.sh",
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "audit:fix": "npm audit --omit=dev --audit-level=moderate --fix",
    "lint": "eslint . --ext .js --ignore-pattern 'src/__tests__/*' --ignore-pattern 'load-tests/*' --ignore-pattern 'scripts/*'",
    "codacy:analyze": "codacy-analysis analyze .",
    "codacy:info": "codacy-analysis info",
    "codacy:upload": "codacy-analysis upload"
  },
  "author": "Slavyan Hristov",
  "license": "ISC",
  "devDependencies": {
    "autocannon": "8.0.0", // guardrails-disable-line - pinned to latest 8.0.0 release
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "jest": "30.4.2",
    "nodemon": "^3.1.14",
    "sequelize-cli": "6.6.5"
  },
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "archiver": "^8.0.0",
    "axios": "^1.18.1",
    "axios-debug-log": "^1.0.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.11",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "4.22.2", // guardrails-disable-line - CVE-2024-51999 rejected, pinned to latest 4.x release
    "google-auth-library": "^11.0.2",
    "helmet": "^6.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.23.3",
    "node-forge": "^1.3.1",
    "nodemailer": "^9.0.5",
    "passkit-generator": "^3.5.7",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "redis": "^5.12.1",
    "sequelize": "6.37.8", // guardrails-disable-line - pinned to latest 6.x release
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "winston": "^3.19.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "joi": "17.13.4",
    "js-yaml": "5.3.0",
    "glob": "13.0.6",
    "brace-expansion": "5.0.9"
  }
}
