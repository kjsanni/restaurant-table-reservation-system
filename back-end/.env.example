# Backend environment variables
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to version control.

PORT=8000
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=reserve
DB_PASSWORD=reserve
DB_NAME=reserve
DB_DIALECT=mysql

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_SECRET=change-me-to-another-random-64-char-string

# Frontend
FRONTEND_URL=http://localhost:8080

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:8080

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Rate limiting (optional overrides)
# RATE_LIMIT_DISABLED=true
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_GENERAL_MAX=100
# RATE_LIMIT_BULK_MAX=5
# RATE_LIMIT_ADMIN_MAX=3
# RATE_LIMIT_SYNC_MAX=60
# RATE_LIMIT_WEBHOOK_MAX=120

# Restaurant name
RESTAURANT_NAME=BV360
