{
  "$schema": "https://unpkg.com/@changesets/config@3.0.0/schema.json",
  "changelog": "@changesets/cli/changelog",
  "commit": false,
  "openArrayBuffer": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [
    "Dockerfile",
    "*.config.js"
  ],
  "custom": false,
  "channels": {
    "standard": {
      "sources": {
        "changesets": {
          "base": 1
        },
        "pullRequests": {
          "base": 1
        }
      }
    }
  }
}
