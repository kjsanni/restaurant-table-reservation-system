{
  "name": "restaurant-table-reservation-system-front-end",
  "version": "1.1.0",
  "description": "Front-end of Restaurant Table Reservation System. Created with VueJS 3.",
  "repository": {
    "type": "git",
    "url": "https://github.com/slavyanHristov/restaurant-table-reservation-system",
    "directory": "/front-end"
  },
  "scripts": {
    "dev": "vite",
    "dev:super-admin": "vite --config vite.config.super-admin.js",
    "dev:tenant": "vite --config vite.config.tenant.js",
    "dev:customer": "vite --config vite.config.customer.js",
    "build": "vite build",
    "build:super-admin": "vite build --config vite.config.super-admin.js",
    "build:tenant": "vite build --config vite.config.tenant.js",
    "build:customer": "vite build --config vite.config.customer.js",
    "preview": "vite preview",
    "test:unit": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest --environment jsdom --root src/",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-pattern 'tests/*' --ignore-pattern 'dist/*' --ignore-pattern 'test-results/*' --ignore-pattern 'playwright-report/*'",
    "format": "prettier .  --write"
  },
  "dependencies": {
    "@iconify/json": "^2.1.131",
    "@iconify/utils": "2.2.0",
    "@iconify/vue": "^4.0.0",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vue/compiler-sfc": "^3.2.41",
    "axios": "^1.19.0",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.13",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.4",
    "socket.io-client": "^4.8.3",
    "unplugin-icons": "^0.14.12",
    "vue": "^3.5.41",
    "vue-router": "^4.1.5",
    "vuestic-ui": "^1.10.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@rushstack/eslint-patch": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.2.7",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^20.0.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "rollup": "^4.62.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "rollup-plugin-vue": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
}
